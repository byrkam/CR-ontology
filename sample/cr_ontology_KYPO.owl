<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:cr="http://example.org/cr-ontology#"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <owl:ObjectProperty rdf:about="http://example.org/cr-ontology#hasPurpose">
    <rdfs:domain rdf:resource="http://example.org/cr-ontology#ScopeDecisionalAspect"/>
    <rdfs:range rdf:resource="http://example.org/cr-ontology#Purpose"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://example.org/cr-ontology#targetsDidactics">
    <rdfs:domain rdf:resource="http://example.org/cr-ontology#ScopeDecisionalAspect"/>
    <rdfs:range rdf:resource="http://example.org/cr-ontology#Didactics"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://example.org/cr-ontology#producesInformation">
    <rdfs:domain rdf:resource="http://example.org/cr-ontology#FunctionalAspect"/>
    <rdfs:range rdf:resource="http://example.org/cr-ontology#InformationalAspect"/>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="http://example.org/cr-ontology#isProducedBy">
        <rdfs:domain rdf:resource="http://example.org/cr-ontology#InformationalAspect"/>
        <rdfs:range rdf:resource="http://example.org/cr-ontology#FunctionalAspect"/>
      </owl:ObjectProperty>
    </owl:inverseOf>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://example.org/cr-ontology#supportsCapability">
    <rdfs:domain rdf:resource="http://example.org/cr-ontology#CyberRange"/>
    <rdfs:range rdf:resource="http://example.org/cr-ontology#Capability"/>
    <owl:propertyChainAxiom rdf:parseType="Collection">
      <rdf:Description rdf:about="http://example.org/cr-ontology#hasFunctionalAspect"/>
      <rdf:Description rdf:about="http://example.org/cr-ontology#enablesCapability"/>
    </owl:propertyChainAxiom>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://example.org/cr-ontology#hasDescription">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="http://example.org/cr-ontology#KYPO_CyberRangePlatform">
    <rdf:type rdf:resource="http://example.org/cr-ontology#CyberRange"/>
    <cr:hasName>KYPO Cyber Range Platform</cr:hasName>
    <cr:hasDescription>Open-source cyber range platform developed by Masaryk University for hands-on cybersecurity training and cyber defense exercises.</cr:hasDescription>
    <cr:hasVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">as described in public documentation and literature</cr:hasVersion>
    <cr:hasDecisionalAspect>
      <owl:NamedIndividual rdf:about="http://example.org/cr-ontology#KYPO_InfrastructureDecisions">
        <rdf:type rdf:resource="http://example.org/cr-ontology#InfrastructureDecisionalAspect"/>
        <cr:hasName>KYPO infrastructure decisional aspect</cr:hasName>
        <cr:hasDescription>Key infrastructure design choices of KYPO CRP (delivery model, virtualization stack, governance).</cr:hasDescription>
        <cr:hasDeliveryModel rdf:resource="http://example.org/cr-ontology#DeliveryModel_CloudBased"/>
        <cr:hasVirtualizationTechnology rdf:resource="http://example.org/cr-ontology#VirtualizationTechnology_OpenStack"/>
        <cr:hasGovernance rdf:resource="http://example.org/cr-ontology#Governance_MasarykUniversity"/>
        <cr:hasInfrastructureType rdf:resource="http://example.org/cr-ontology#InfrastructureType_OpenStackCloud"/>
        <cr:hasDomain rdf:resource="http://example.org/cr-ontology#Domain_CybersecurityTraining"/>
        <cr:hasScope rdf:resource="http://example.org/cr-ontology#Scope_TrainingAndExercises"/>
        <cr:constrainsFunction rdf:resource="http://example.org/cr-ontology#KYPO_InfrastructureSandboxProvisioning"/>
        <cr:constrainsFunction rdf:resource="http://example.org/cr-ontology#KYPO_ScenarioLifecycleManagement"/>
      </owl:NamedIndividual>
    </cr:hasDecisionalAspect>
    <cr:hasDecisionalAspect>
      <owl:NamedIndividual rdf:about="http://example.org/cr-ontology#KYPO_ScopeDecisions">
        <rdf:type rdf:resource="http://example.org/cr-ontology#ScopeDecisionalAspect"/>
        <cr:hasName>KYPO scope decisional aspect</cr:hasName>
        <cr:hasDescription>Pedagogical and audience-oriented choices of KYPO CRP (learning approach, evaluation practices, target users).</cr:hasDescription>
        <cr:hasLearningMethod rdf:resource="http://example.org/cr-ontology#LearningMethod_ScenarioDrivenHandsOn"/>
        <cr:hasEvaluationPractice rdf:resource="http://example.org/cr-ontology#EvaluationPractice_MonitoringAndAnalytics"/>
        <cr:hasCurriculaType rdf:resource="http://example.org/cr-ontology#CurriculumType_ModularScenarios"/>
        <cr:hasPurpose rdf:resource="http://example.org/cr-ontology#Purpose_HandsOnTrainingAndExercises"/>
        <cr:targetsDidactics rdf:resource="http://example.org/cr-ontology#Didactics_HandsOnPractice"/>
        <cr:definesUserType rdf:resource="http://example.org/cr-ontology#UserType_StudentsAndProfessionals"/>
        <cr:definesUserTeam rdf:resource="http://example.org/cr-ontology#UserTeam_MultiTeamExercises"/>
        <cr:constrainsFunction rdf:resource="http://example.org/cr-ontology#KYPO_ScenarioLifecycleManagement"/>
      </owl:NamedIndividual>
    </cr:hasDecisionalAspect>
    <cr:hasFunctionalAspect>
      <owl:NamedIndividual rdf:about="http://example.org/cr-ontology#KYPO_InfrastructureSandboxProvisioning">
        <rdf:type rdf:resource="http://example.org/cr-ontology#InfrastructureFunctionalAspect"/>
        <cr:hasName>Sandbox provisioning and isolation</cr:hasName>
        <cr:hasDescription>Provisioning of isolated virtual sandboxes and network topologies using OpenStack-managed resources.</cr:hasDescription>
        <cr:producesInformation rdf:resource="http://example.org/cr-ontology#KYPO_TelemetryAndLogs"/>
        <cr:enablesCapability rdf:resource="http://example.org/cr-ontology#Capability_IsolatedReproducibleSandboxes"/>
        <cr:enablesCapability rdf:resource="http://example.org/cr-ontology#Capability_CyberDefenseExercises"/>
      </owl:NamedIndividual>
    </cr:hasFunctionalAspect>
    <cr:hasFunctionalAspect>
      <owl:NamedIndividual rdf:about="http://example.org/cr-ontology#KYPO_ScenarioLifecycleManagement">
        <rdf:type rdf:resource="http://example.org/cr-ontology#RLMSFunctionalAspect"/>
        <cr:hasName>Scenario lifecycle management</cr:hasName>
        <cr:hasDescription>Management of scenario definitions, sandbox instantiation, and training execution workflows.</cr:hasDescription>
        <cr:producesInformation rdf:resource="http://example.org/cr-ontology#KYPO_ScenarioDefinitions"/>
        <cr:producesInformation rdf:resource="http://example.org/cr-ontology#KYPO_EvaluationResults"/>
        <cr:consumesInformation rdf:resource="http://example.org/cr-ontology#KYPO_ScenarioDefinitions"/>
        <cr:enablesCapability rdf:resource="http://example.org/cr-ontology#Capability_ScenarioDrivenHandsOnTraining"/>
        <cr:enablesCapability rdf:resource="http://example.org/cr-ontology#Capability_MultiUserMultiTeamExecution"/>
      </owl:NamedIndividual>
    </cr:hasFunctionalAspect>
    <cr:hasFunctionalAspect>
      <owl:NamedIndividual rdf:about="http://example.org/cr-ontology#KYPO_UserPortalRemoteAccess">
        <rdf:type rdf:resource="http://example.org/cr-ontology#UserOrientedFunctionalAspect"/>
        <cr:hasName>Web portal and remote access</cr:hasName>
        <cr:hasDescription>User-facing web portal for accessing sandboxes and interacting with virtual machines via SSH/VNC/SPICE or browser-based access.</cr:hasDescription>
        <cr:consumesInformation rdf:resource="http://example.org/cr-ontology#KYPO_ScenarioDefinitions"/>
        <cr:producesInformation rdf:resource="http://example.org/cr-ontology#KYPO_EvaluationResults"/>
        <cr:enablesCapability rdf:resource="http://example.org/cr-ontology#Capability_RemoteAccessToSandboxResources"/>
        <cr:enablesCapability rdf:resource="http://example.org/cr-ontology#Capability_ScenarioDrivenHandsOnTraining"/>
      </owl:NamedIndividual>
    </cr:hasFunctionalAspect>
    <cr:hasInformationalAspect>
      <owl:NamedIndividual rdf:about="http://example.org/cr-ontology#KYPO_TelemetryAndLogs">
        <rdf:type rdf:resource="http://example.org/cr-ontology#InfrastructureInformationalAspect"/>
        <cr:hasName>Telemetry and runtime logs</cr:hasName>
        <cr:hasDescription>Operational logs and telemetry produced during sandbox deployment and execution for monitoring and analysis.</cr:hasDescription>
      </owl:NamedIndividual>
    </cr:hasInformationalAspect>
    <cr:hasInformationalAspect>
      <owl:NamedIndividual rdf:about="http://example.org/cr-ontology#KYPO_ScenarioDefinitions">
        <rdf:type rdf:resource="http://example.org/cr-ontology#RLMSInformationalAspect"/>
        <cr:hasName>Scenario definitions and sandbox topologies</cr:hasName>
        <cr:hasDescription>Version-controlled definitions of scenarios and sandbox topologies (e.g., stored in Git repositories).</cr:hasDescription>
      </owl:NamedIndividual>
    </cr:hasInformationalAspect>
    <cr:hasInformationalAspect>
      <owl:NamedIndividual rdf:about="http://example.org/cr-ontology#KYPO_EvaluationResults">
        <rdf:type rdf:resource="http://example.org/cr-ontology#RLMSInformationalAspect"/>
        <cr:hasName>Evaluation artifacts</cr:hasName>
        <cr:hasDescription>Artifacts supporting learner monitoring and evaluation (e.g., progress, activity traces, assessment outputs).</cr:hasDescription>
      </owl:NamedIndividual>
    </cr:hasInformationalAspect>
  </owl:NamedIndividual>
