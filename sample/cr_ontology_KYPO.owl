  <owl:Class rdf:about="http://example.org/cr-ontology#CyberRange">
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N3c6657a2668e4cc5addac1e52ddf2ac1">
        <owl:onProperty rdf:resource="http://example.org/cr-ontology#hasDecisionalAspect"/>
        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
        <owl:onClass rdf:resource="http://example.org/cr-ontology#DecisionalAspect"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N1a105649a33241699db27bb7df3a6300">
